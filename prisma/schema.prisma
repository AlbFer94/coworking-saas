// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
  previewFeatures= ["postgresqlExtensions"] // Abilita la feature preview di Prisma per le estensioni
}

datasource db {
  provider  = "postgresql"
  extensions=[btree_gist] //abilita l'estensione tramite l'ORM
}

model Tenant {
  id        String    @id @default(uuid()) 
  name      String                        
  slug      String    @unique  
  status    String    @default("INACTIVE")            
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  users     User[]
  rooms     Room[]
  bookings  Booking[]

  @@index([slug]) 
}

model User {
  id        String   @id @default(uuid()) 
  firstName String
  lastName  String
  email     String  @unique
  role      String  @default("MEMBER")
  tenantId  String 
  tenant    Tenant  @relation(fields:[tenantId], references:[id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  credits   Int     @default(10)
  bookings  Booking[]

  @@unique([tenantId, email])
}

model Room {
  id        Int    @id @default(autoincrement())
  name      String // Es: "Sala proiezioni"
  price     Float  // Es: 25.00
  duration  Int    // Durata in minuti, es: 60
  tenantId  String
  tenant    Tenant  @relation(fields:[tenantId], references:[id], onDelete: Cascade)
  bookings  Booking[]
}

model Booking {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String
  startTime DateTime // Usa DateTime per gestire meglio i giorni
  endTime   DateTime  
  range     Unsupported("tsrange")?   // Colonna generata da Postgres (GENERATED ALWAYS AS tsrange(startTime,endTime) STORED, vedi migration iniziale).
  // Il DB la tratta come NOT NULL, ma qui DEVE restare "?": senza il "?", Prisma
  // disabilita create/update/upsert sull'intero model (limite noto per campi Unsupported obbligatori).
  // ATTENZIONE: ogni `migrate dev`/`migrate diff` proporrà "DROP NOT NULL"/"DROP DEFAULT" su questa colonna:
  // è un artefatto fantasma dell'introspezione, NON applicarlo mai. Se compare da solo, Ctrl+C senza dare un nome.

  tenantId  String
  userId    String
  roomId    Int
  room      Room     @relation(fields:[roomId], references:[id], onDelete: Cascade)
  tenant    Tenant  @relation(fields:[tenantId], references:[id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt DateTime @default(now())
}



